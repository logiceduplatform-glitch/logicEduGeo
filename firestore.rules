rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Classroom quizzes: teachers create/manage, anyone can read & play
    match /classroomQuizzes/{code} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.teacherUid == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.teacherUid == request.auth.uid
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["timesPlayed"])));
      allow delete: if request.auth != null
                    && resource.data.teacherUid == request.auth.uid;
    }

    // Classroom announcements: teacher creates, anyone can read
    match /classroomAnnouncements/{announcementId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.teacherUid == request.auth.uid;
    }

    // Classroom quiz results: anyone can submit, authenticated users can read
    match /classroomResults/{resultId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if false;
    }

    // Classrooms: teacher creates/manages, anyone can read
    match /classrooms/{classroomId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.teacherUid == request.auth.uid;
    }

    // Classroom members: anyone can join (create), authenticated can delete (teacher removes)
    match /classroomMembers/{memberId} {
      allow read: if true;
      allow create: if true;
      allow delete: if request.auth != null;
      allow update: if false;
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
