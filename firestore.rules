rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == "logic.edu.platform@gmail.com";
    }

    function isAdmin() {
      return request.auth != null
        && (isSuperAdmin()
            || (request.auth.token.admin == true)
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Each user can only read/write their own data; admins can read & write any user.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Admins collection (managed by super admins / existing admins)
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin() || isAdmin();
    }

    // Feature flags - public read, admin write
    match /featureFlags/{flagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Premium content list - public read (so the gate can check), admin write
    match /premiumContent/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System announcements - public read, admin write
    match /systemAnnouncements/{annId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System config (maintenance) - public read, admin write
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin logs - only admins can read/write
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Reports - users can create, admins can read/update
    match /reports/{reportId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.reporterUid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.reporterUid == request.auth.uid
                    && request.resource.data.status == "open";
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Classroom quizzes: teachers create/manage, anyone can read & play
    match /classroomQuizzes/{code} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.teacherUid == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.teacherUid == request.auth.uid
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["timesPlayed"])));
      allow delete: if request.auth != null
                    && resource.data.teacherUid == request.auth.uid;
    }

    // Classroom announcements: teacher creates, authenticated users can read
    match /classroomAnnouncements/{announcementId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.teacherUid == request.auth.uid;
    }

    // Classroom quiz results: authenticated users can submit and read, teachers can add feedback
    match /classroomResults/{resultId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["teacherFeedback"]);
      allow delete: if false;
    }

    // Classrooms: teacher creates/manages, authenticated users can read
    match /classrooms/{classroomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.teacherUid == request.auth.uid;
    }

    // Classroom members: authenticated users can join/read, only classroom teacher can delete
    match /classroomMembers/{memberId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null
                    && exists(/databases/$(database)/documents/classrooms/$(resource.data.classroomCode))
                    && get(/databases/$(database)/documents/classrooms/$(resource.data.classroomCode)).data.teacherUid == request.auth.uid;
      allow update: if false;
    }

    // Classroom lessons: teachers create/manage, authenticated users can read
    match /classroomLessons/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.teacherUid == request.auth.uid;
    }

    // Live quiz sessions: anyone can read/join, host creates
    match /liveQuizSessions/{sessionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if true;
      allow delete: if request.auth != null;
    }

    // Classroom homework: teachers create, authenticated users read
    match /classroomHomework/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.teacherUid == request.auth.uid;
    }

    // Homework submissions: authenticated users can submit, teachers can read
    match /homeworkSubmissions/{submissionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    // Friend challenges: anyone can read/create/update
    match /friendChallenges/{code} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Online quiz battles: authed users can read/create; participants can update
    match /onlineBattles/{code} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && (resource.data.player1.uid == request.auth.uid || isAdmin());
    }

    // Guilds (crews): public read, members can update
    match /guilds/{guildId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }

    // Guild memberships: public read, user manages own
    match /guildMembers/{memberId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Public profiles: public read, owner write
    match /publicProfiles/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Schools: owner manages; authenticated users can read for join flows
    match /schools/{schoolId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.ownerUid == request.auth.uid;
    }
    // School classes: teacher manages; readable for kid login flows
    match /schoolClasses/{classId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.teacherUid == request.auth.uid;
    }
    // School students: managed by their teacher; readable for QR login lookups
    match /schoolStudents/{studentId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Affiliate codes & referrals
    match /affiliates/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if isAdmin();
    }
    match /referrals/{referralId} {
      allow read: if request.auth != null
                  && (resource.data.referrerUid == request.auth.uid
                      || resource.data.refereeUid == request.auth.uid
                      || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Parent-Teacher messages: parent and teacher of a thread can read/write
    match /parentTeacherMessages/{messageId} {
      allow read: if request.auth != null
                  && (resource.data.parentUid == request.auth.uid
                      || resource.data.teacherUid == request.auth.uid);
      allow create: if request.auth != null
                    && (request.resource.data.parentUid == request.auth.uid
                        || request.resource.data.teacherUid == request.auth.uid);
      allow update: if request.auth != null
                    && (resource.data.parentUid == request.auth.uid
                        || resource.data.teacherUid == request.auth.uid);
      allow delete: if false;
    }

    // Co-teacher invites: inviter creates/deletes, invitee can read & update status
    match /coTeacherInvites/{inviteId} {
      allow read: if request.auth != null
                  && (resource.data.inviterUid == request.auth.uid
                      || resource.data.inviteeEmail == request.auth.token.email);
      allow create: if request.auth != null
                    && request.resource.data.inviterUid == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.inviterUid == request.auth.uid
                        || resource.data.inviteeEmail == request.auth.token.email);
      allow delete: if request.auth != null
                    && resource.data.inviterUid == request.auth.uid;
    }

    // Global leaderboard: anyone authed can read; users can submit only their own
    match /globalLeaderboard/{entryId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.score is number
                    && request.resource.data.score >= 0;
      allow update, delete: if request.auth != null
                              && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Print-on-demand orders: users can create/read their own; admins can read/update all.
    match /podOrders/{orderId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null
                  && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Error reports: anyone (incl. anonymous visitors) can write; only admins
    // can read. Documents are write-only with strict size limits to prevent
    // abuse of the free-tier quota.
    match /errorReports/{reportId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.message is string
                    && request.resource.data.message.size() < 2000
                    && request.resource.data.size() < 30;
      allow update, delete: if isAdmin();
    }

    // School licenses (B2B). Public read by key (so a teacher can validate
    // before activation), admins issue/update; activation appends the
    // current user to members[] (handled below).
    match /schoolLicenses/{key} {
      allow read: if true; // public lookup by key
      allow create, delete: if isAdmin();
      // Admins can update everything; non-admins can only append themselves
      // to members[] and increment activeCount by 1 (license activation).
      allow update: if isAdmin()
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['members', 'activeCount', 'updatedAt'])
            && request.resource.data.activeCount == resource.data.activeCount + 1);
    }

    // Friend challenges — async 1v1 quizzes.
    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.size() < 20;
      allow update: if request.auth != null
                    && (resource.data.fromUid == request.auth.uid
                        || resource.data.toUid == request.auth.uid
                        || resource.data.toUid == null /* open challenge */);
      allow delete: if request.auth != null
                    && (resource.data.fromUid == request.auth.uid || isAdmin());
    }

    // Live classroom rooms (Kahoot-style).
    match /liveRooms/{roomId} {
      allow read: if true; // anyone with the code can see room state
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.hostUid == request.auth.uid
                        || /* players can submit answers */
                           request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['players', 'updatedAt']));
      allow delete: if request.auth != null
                    && (resource.data.hostUid == request.auth.uid || isAdmin());
    }

    // User feedback (NPS-style 1-5 + optional comment).
    // Anyone (incl. anonymous) can submit; only admins can read/manage.
    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.score is int
                    && request.resource.data.score >= 1
                    && request.resource.data.score <= 5
                    && (!('comment' in request.resource.data)
                        || (request.resource.data.comment is string
                            && request.resource.data.comment.size() < 1000))
                    && request.resource.data.size() < 20;
      allow update, delete: if isAdmin();
    }

    // Stripe subscription status mirror: read by owner, write only by Cloud Functions
    match /subscriptions/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid || isAdmin());
      allow write: if false; // server-only via Cloud Functions / webhooks
    }

    // Stripe checkout sessions (write by user, read by user, server processes)
    match /checkoutSessions/{sessionId} {
      allow read: if request.auth != null
                  && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Email queue — server-only (Cloud Function workers). Admins can read for
    // debugging; no client writes.
    match /emailQueue/{itemId} {
      allow read: if isAdmin();
      allow write: if false; // server-only
    }

    // Push notification campaigns — admins create, server consumes
    match /pushCampaigns/{campaignId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
