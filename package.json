{
  "name": "kibloo",
  "version": "1.0.0",
  "private": true,
  "description": "Kibloo — where curiosity blooms. A playful learning world for kids 2–12 and curious adults.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/allAgeGroups.mjs",
    "test:e2e:nav": "node tests/e2e/navigation.mjs",
    "test:e2e:full": "node tests/e2e/fullJourneys.mjs",
    "test:e2e:features": "node tests/e2e/newFeatures.mjs",
    "test:e2e:teacher": "node tests/e2e/teacherFlow.mjs",
    "test:all": "vitest run && echo '--- Unit/Component tests passed ---'",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "vitest run --reporter=verbose src/test/accessibility.test.jsx",
    "test:bundle": "vitest run --reporter=verbose src/test/bundleSize.test.js"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "firebase": "^12.5.0",
    "html2pdf.js": "^0.14.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.9.5",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.0",
    "axe-core": "^4.11.1",
    "jest-axe": "^10.0.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "vite": "^7.2.1",
    "vitest": "^4.0.18"
  }
}
