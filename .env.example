# Firebase Configuration (required for auth)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase App Check (anti-abuse) — optional but RECOMMENDED for production.
# 1. Console → App Check → Web app → Register with reCAPTCHA v3
# 2. Get the site key from the reCAPTCHA admin panel
# 3. Whitelist your domain
VITE_RECAPTCHA_V3_SITE_KEY=

# Stripe checkout API URL (your backend endpoint)
VITE_STRIPE_API_URL=https://yourdomain.com/api

# AI proxy backend URL (optional, for AI study assistant)
VITE_AI_API_URL=https://yourdomain.com/api/ai-chat

# Error reporting endpoint (optional, receives JSON error reports via sendBeacon)
VITE_ERROR_REPORTING_URL=https://yourdomain.com/api/errors

# Sentry — production error tracking (https://sentry.io)
# Free tier: 5K events/month. Leave blank to disable.
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=production
VITE_SENTRY_RELEASE=kibloo@1.0.0

# Newsletter signup webhook (Mailchimp/ConvertKit/Brevo/Mailerlite). Optional.
# When set, NewsletterService POSTs { email, source, language } to this URL.
# When unset, signups are stored only in Firestore (`newsletter` collection).
VITE_NEWSLETTER_WEBHOOK=

# Customer support chat widget (Crisp or Tawk.to). Optional.
# Pick ONE provider and supply its IDs.
#   crisp:  https://crisp.chat       (free: 2 ops, unlimited convos)
#   tawk:   https://www.tawk.to      (100% free, unlimited)
VITE_SUPPORT_PROVIDER=
VITE_CRISP_WEBSITE_ID=
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=default
